    "algorithm_analysis": {
        "why_decision_tree_and_random_forest": "Decision Tree offers full interpretability and non-linear rule boundaries, but is prone to variance. Random Forest constructs an ensemble of decorrelated trees via bagging and random feature subsampling, achieving robust generalization on tabular agronomic data without requiring feature scaling.",
        "alternative_algorithms_evaluation": {
            "SVM (Support Vector Machine)": "SVM with RBF kernel is effective in continuous multi-dimensional space, but requires feature standardization, is computationally heavier during training (O(n^2) to O(n^3)), and does not provide native tree feature importances.",
            "k-NN (k-Nearest Neighbors)": "k-NN is sensitive to feature scaling, irrelevant features, and incurs high inference latency O(N*D) since it computes distances to all 2,200 points on every web prediction."
        },
        "why_limited_to_two": "Constraining to Decision Tree vs Random Forest presents a mathematically clean comparison between a single weak learner and an ensemble bagging architecture. This directly addresses the bias-variance tradeoff required for MCA academic viva."
    }
